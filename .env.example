# Platform Environment Variables Template
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication Setup
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_key
CLERK_SECRET_KEY=sk_test_sample_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_sample_webhook_secret

# PostgreSQL Database Connection (Neon / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/vikramedu_db?schema=public

# AWS S3 Storage
AWS_S3_BUCKET=vikram-edu-documents
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=sample_access_key
AWS_SECRET_ACCESS_KEY=sample_secret_key

# OpenAI Service Key
OPENAI_API_KEY=sk-sample-openai-key

# Resend Transactional Email Key
RESEND_API_KEY=re_sample_resend_key
